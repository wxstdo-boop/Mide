<?xml version="1.0" encoding="utf-8"?>
<!--
  Empty icon for the Android 12+ platform splash. The system would otherwise
  draw the launcher icon (a white adaptive plate with the glyph inside it) in
  the middle of the launch window, so the logo showed up twice during start-up:
  once small from the system, once larger from the in-app emblem. An empty
  drawable keeps the logo a single, deliberate element.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <size
        android:width="1dp"
        android:height="1dp" />
    <solid android:color="@android:color/transparent" />
</shape>