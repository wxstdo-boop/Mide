# ===== Mide AGI sidecar: конфигурация =====
# Скопируй в .env и заполни нужное.

# --- Провайдер модели ---
#   ollama            — бесплатно, локально (своя машина), интернет не нужен
#   google            — Gemini (нужен ключ GEMINI_API_KEY)
#   openai            — OpenAI (нужен ключ)
#   openrouter        — OpenRouter (нужен ключ)
#   openai-compatible — любой OpenAI-совместимый API (свой BASE_URL)
PROVIDER=ollama

# Модель. Для ollama — уже скачанная локально, например:
#   qwen2.5-coder:7b   (кодинг, бесплатно, ~4.7 ГБ)
#   llama3.1:8b        (универсальная)
#   deepseek-coder-v2:16b (побольше, если хватает памяти)
MODEL=qwen2.5-coder:7b

# API-ключ (для google/openai/openrouter). Для ollama можно оставить пустым.
API_KEY=

# Кастомный адрес API. Для ollama обычно не нужно (по умолчанию http://127.0.0.1:11434).
# Для openai-compatible — обязательно, например https://api.deepseek.com/v1
BASE_URL=

# Рабочая папка агента (проект, с которым работает ИИ).
# Пусто = корень проекта (папка, в которой лежит agent/).
WORKSPACE=

# Порт HTTP-сервера.
AGENT_PORT=8765

# 1 = выполнять команды без подтверждения (осторожно!)
# 0 = агент запрашивает разрешение через интерфейс Mide (событие approval
#     в /chat + POST /approve). Из консоли ответить нельзя.
AUTO_APPROVE=0

# Сколько ждать ответа интерфейса, прежде чем отклонить команду (мс).
APPROVAL_TIMEOUT_MS=300000
